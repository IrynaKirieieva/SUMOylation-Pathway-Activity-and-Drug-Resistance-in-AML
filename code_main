### ============================================================
### 5. GENOME-WIDE DIFFERENTIAL EXPRESSION AND ENRICHMENT
### ============================================================
# Independent test of the pathway-level hypothesis: instead of the 19 genes
# chosen a priori, ask what differs across the FULL proteome between high-
# and low-E1-complex-activity patients, and whether SUMO-related biology is
# enriched among the result.

# ---- 5.1 High/low E1 complex score grouping and full-proteome expression matrix ----

e1_groups <- e1_complex_score %>%
  filter(!is.na(e1_score)) %>%
  mutate(e1_group = if_else(e1_score > median(e1_score), "high", "low"))

# e1_complex_score is keyed by dbgap_subject_id; the expression matrix is
# keyed by ptrc_id, so map back through sumo_protein_long's unique pairing
patient_id_map <- sumo_protein_long %>% distinct(ptrc_id, dbgap_subject_id)

e1_groups <- e1_groups %>%
  inner_join(patient_id_map, by = "dbgap_subject_id")

expr_wide <- protein_matrix %>%
  as.data.frame() %>%
  column_to_rownames("Gene")
colnames(expr_wide) <- str_remove(colnames(expr_wide), " Log Ratio$")

expr_matrix <- as.matrix(expr_wide[, e1_groups$ptrc_id])

# ---- 5.2 limma: moderated t-test across the full proteome ----

group_factor <- factor(e1_groups$e1_group, levels = c("low", "high"))
design <- model.matrix(~ group_factor)

fit <- eBayes(lmFit(expr_matrix, design))

dea_results <- topTable(fit, coef = "group_factorhigh", number = Inf) %>%
  as_tibble(rownames = "Gene") %>%
  arrange(adj.P.Val)

# SAE1 and UBA2 top this list by construction (groups were defined by their
# combined score) — expected, not an independent finding. Interest is in the
# rest of the ranked list.

# volcano plot: SUMO pathway genes highlighted

volcano_data <- dea_results %>%
  mutate(
    sig = adj.P.Val < 0.05,
    is_sumo_gene = Gene %in% SUMO_PATHWAY_GENES,
    label = if_else(is_sumo_gene & sig, Gene, NA_character_)
  )

p_volcano <- ggplot(volcano_data, aes(logFC, -log10(P.Value))) +
  geom_point(aes(color = sig), size = 1, alpha = 0.4) +
  geom_point(data = filter(volcano_data, is_sumo_gene), color = "#E74C3C", size = 2) +
  geom_text_repel(aes(label = label), size = 3, max.overlaps = 20, min.segment.length = 0) +
  scale_color_manual(values = c("TRUE" = "#2C3E50", "FALSE" = "grey75"), guide = "none") +
  labs(
    title = "Differential expression: high vs low E1 complex activity",
    subtitle = "SUMO pathway genes highlighted in red",
    x = "log fold change", y = "-log10(p-value)"
  ) +
  theme_minimal(base_size = 12)

print(p_volcano)
ggsave("figures/dea_volcano.png", p_volcano, width = 7, height = 6, dpi = 300)

# volcano plot: top non-SUMO hits highlighted

top_non_sumo <- dea_results %>%
  filter(!Gene %in% SUMO_PATHWAY_GENES, adj.P.Val < 0.05) %>%
  slice_min(order_by = adj.P.Val, n = 15) %>%
  pull(Gene)

volcano_data_nonsumo <- dea_results %>%
  mutate(
    sig = adj.P.Val < 0.05,
    is_top_hit = Gene %in% top_non_sumo,
    label = if_else(is_top_hit, Gene, NA_character_)
  )

p_volcano_nonsumo <- ggplot(volcano_data_nonsumo, aes(logFC, -log10(P.Value))) +
  geom_point(aes(color = sig), size = 1, alpha = 0.4) +
  geom_point(data = filter(volcano_data_nonsumo, is_top_hit), color = "#27AE60", size = 2) +
  geom_text_repel(aes(label = label), size = 3, max.overlaps = 20, min.segment.length = 0) +
  scale_color_manual(values = c("TRUE" = "#2C3E50", "FALSE" = "grey75"), guide = "none") +
  labs(
    title = "Differential expression: high vs low E1 complex activity",
    subtitle = "Top 15 non-SUMO-pathway hits highlighted in green",
    x = "log fold change", y = "-log10(p-value)"
  ) +
  theme_minimal(base_size = 12)

print(p_volcano_nonsumo)
ggsave("figures/dea_volcano_nonsumo.png", p_volcano_nonsumo, width = 7, height = 6, dpi = 300)

# ---- 5.3 GSEA (GO Biological Process), ranked by limma t-statistic ----

ranked_genes <- dea_results %>%
  filter(!is.na(t)) %>%
  arrange(desc(t)) %>%
  pull(t, name = Gene)

set.seed(42)  # explicit seed so gseGO's permutation-based test is reproducible

gsea_results <- gseGO(
  geneList = ranked_genes,
  OrgDb = org.Hs.eg.db,
  keyType = "SYMBOL",
  ont = "BP",
  minGSSize = 10,
  maxGSSize = 500,
  pvalueCutoff = 0.05,
  seed = FALSE
)

gsea_summary <- as_tibble(gsea_results@result) %>% arrange(p.adjust)

# NES > 0: term enriched among genes associated with high E1 complex activity.
# NES < 0: term enriched among genes associated with low E1 complex activity.

top_terms <- gsea_summary %>%
  arrange(p.adjust, desc(abs(NES))) %>%  # break ties in p.adjust by effect size
  slice_head(n = 8) %>%
  mutate(
    Description = str_wrap(Description, width = 40),
    Description = fct_reorder(Description, NES)
  )

p_gsea_small <- ggplot(top_terms, aes(NES, Description, size = setSize)) +
  geom_point(color = "#2C3E50") +
  labs(title = "Top enriched GO Biological Process terms", x = "NES", y = NULL, size = "Gene set size") +
  theme_minimal(base_size = 13)

print(p_gsea_small)
ggsave("figures/gsea_dotplot_small.png", p_gsea_small, width = 8, height = 5.5, dpi = 300)


### ============================================================
### 6. UNSUPERVISED STRUCTURE CHECK: PCA / UMAP
### ============================================================
# Sanity check: does E1 complex status align with a dominant axis of overall
# proteomic variation, or is it a targeted signature that unsupervised
# clustering wouldn't be expected to pick up on its own?

pca_input <- t(na.omit(expr_matrix))
pca_fit <- prcomp(pca_input, scale. = TRUE)

pca_df <- as_tibble(pca_fit$x[, 1:2], rownames = "ptrc_id") %>%
  left_join(e1_groups %>% dplyr::select(ptrc_id, e1_group), by = "ptrc_id")

var_explained <- round(100 * summary(pca_fit)$importance[2, 1:2], 1)

p_pca <- ggplot(pca_df, aes(PC1, PC2, color = e1_group)) +
  geom_point(size = 2.5, alpha = 0.8) +
  scale_color_manual(values = c(high = "#E74C3C", low = "#2C3E50")) +
  labs(
    title = "PCA of the full proteome",
    x = sprintf("PC1 (%.1f%%)", var_explained[1]),
    y = sprintf("PC2 (%.1f%%)", var_explained[2]),
    color = "E1 complex group"
  )
print(p_pca)
ggsave(file.path(FIG_DIR, "04_pca_full_proteome.png"), p_pca, width = 6.5, height = 5, dpi = 300)

# UMAP — exploratory, non-linear complement to PCA. At n~190 patients,
# results are more parameter-sensitive than typical (thousands-of-points)
# UMAP use cases; report as exploratory only, not a confirmed clustering result.

set.seed(1)
umap_fit <- umap(pca_input, n_neighbors = 15, min_dist = 0.1)

umap_df <- as_tibble(umap_fit, .name_repair = ~ c("UMAP1", "UMAP2")) %>%
  mutate(ptrc_id = rownames(pca_input)) %>%
  left_join(e1_groups %>% dplyr::select(ptrc_id, e1_group), by = "ptrc_id")

p_umap <- ggplot(umap_df, aes(UMAP1, UMAP2, color = e1_group)) +
  geom_point(size = 2.5, alpha = 0.8) +
  scale_color_manual(values = c(high = "#E74C3C", low = "#2C3E50")) +
  labs(title = "UMAP of the full proteome (exploratory)", color = "E1 complex group")
print(p_umap)
ggsave(file.path(FIG_DIR, "05_umap_full_proteome.png"), p_umap, width = 6.5, height = 5, dpi = 300)


