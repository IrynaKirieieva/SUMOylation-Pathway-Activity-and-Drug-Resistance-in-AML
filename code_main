  group_by(Gene, inhibitor) %>%
  filter(n() >= MIN_PATIENTS_PER_DRUG) %>%
  summarise(
    n_patients = n(),
    spearman_r = suppressWarnings(cor(log_ratio, auc, method = "spearman", use = "complete.obs")),
    p_value = suppressWarnings(cor.test(log_ratio, auc, method = "spearman")$p.value),
    .groups = "drop"
  ) %>%
  group_by(Gene) %>%
  mutate(q_value = p.adjust(p_value, method = "BH")) %>%  # corrected within-gene: each gene is its own hypothesis family
  ungroup() %>%
  arrange(Gene, p_value)

gene_summary <- gene_drug_correlations %>%
  group_by(Gene) %>%
  summarise(
    n_drugs_tested = n(),
    n_significant = sum(q_value < 0.05, na.rm = TRUE),
    n_resistance_direction = sum(q_value < 0.05 & spearman_r > 0, na.rm = TRUE),
    n_sensitivity_direction = sum(q_value < 0.05 & spearman_r < 0, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  arrange(desc(n_significant))

