# select minimum patients number for a research
MIN_PATIENTS_PER_DRUG <- 15
MIN_PATIENTS_PER_SUBGROUP <- 8
MIN_PATIENTS_FOR_PLOT <- 30  # excludes small subgroups (e.g. Ralimetinib, n=14) prone to unstable r

# create a vector with all SUMO pathway genes
SUMO_PATHWAY_GENES <- c(
  "SUMO1", "SUMO2", "SUMO3",
  "SAE1", "UBA2",
  "UBE2I",
  "PIAS1", "PIAS2", "PIAS3", "PIAS4",
  "RANBP2", "NSMCE2",
  "RNF4",
