# divide a SUMO_PATHWAY_GENES vector into 2 vectors: SUMOylation and deSUMOylation machinery genes
SUMOYLATION_GENES <- setdiff(SUMO_PATHWAY_GENES, c("SENP1", "SENP2", "SENP3", "SENP5", "SENP6", "SENP7"))
DESUMOYLATION_GENES <- c("SENP1", "SENP2", "SENP3", "SENP5", "SENP6", "SENP7")

# E1 activating enzyme: heterodimer of SAE1 and UBA2 (UBA2 is also known as SAE2)
E1_COMPLEX_GENES <- c("SAE1", "UBA2")


### ============================================================
### 1. DATA PREPARATION
### ============================================================

# ---- 1.1 Proteomics (PDC000477, TMT11, log ratios relative to an in-cohort
#          reference pool — not a healthy control) ----

# upload TMT proteomics files. PDC Study Identifier PDC000477. Study ID 40c5bfc8-0fd9-468c-a1be-d1078285dbca
# Publication: Pino, J.C., Posso, C., Joshi, S.K., Nestor, M., et al. (2024)
# Mapping the proteogenomic landscape enables prediction of drug response in acute myeloid leukemia.
# Cell Reports Medicine Vol. 5(1), 101359
protein_tmt11 <- fread(file.path(DATA_DIR, "CPTAC3_PTRC_PNNL_BEAT_AML_Proteome.tmt11.tsv"))

# delete all unnecessary rows and columns
non_gene_rows <- c("Mean", "Median", "StdDev", "SD", "CV", "N", "Count")
protein_tmt11 <- protein_tmt11[!Gene %in% non_gene_rows]

log_ratio_cols <- grep("Log Ratio$", colnames(protein_tmt11), value = TRUE)
log_ratio_cols <- log_ratio_cols[!grepl("Unshared", log_ratio_cols)]

protein_matrix <- protein_tmt11 %>%
  dplyr::select(Gene, all_of(log_ratio_cols))

# check if all SUMO genes are found
stopifnot(all(SUMO_PATHWAY_GENES %in% protein_matrix$Gene))  # 19/19 coverage check

# rewrite a protein_matrix in a long format
sumo_protein_long <- protein_matrix %>%
  filter(Gene %in% SUMO_PATHWAY_GENES) %>%
  pivot_longer(cols = -Gene, names_to = "ptrc_id", values_to = "log_ratio") %>%
  mutate(ptrc_id = str_remove(ptrc_id, " Log Ratio$"))

# ---- 1.2 Cross-dataset ID resolution: PTRC aliquot ID -> labId -> dbgap_subject_id
#
# This analysis combines two independently released datasets that share the
# same underlying patient cohort: proteomics (PDC000477, PTRC) and
# clinical/drug response data (BeatAML/dbGaP).
#
# The proteomics matrix uses PTRC aliquot IDs, and the clinical/drug data uses
# dbgap_subject_id — these two ID systems have no direct shared key. The
# bridge between them is labId, which is not present in either main dataset
# directly, but is provided by two separate mapping files: PDC's biospecimen
# export (aliquot ID -> labId) and BeatAML's official sample mapping file
# (labId -> dbgap_subject_id).

# upload patient ID files.
# 1: PDC Study Identifier PDC000477. Study ID 40c5bfc8-0fd9-468c-a1be-d1078285dbca
# link: https://pdc.cancer.gov/pdc/study/PDC000477
