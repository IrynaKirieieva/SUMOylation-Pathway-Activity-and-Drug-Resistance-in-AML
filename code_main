  geom_vline(xintercept = 0, color = "grey40") +
  scale_fill_manual(values = c(
    composite_score = "#7F8C8D", SUMOYLATION_score = "#2C3E50",
    DESUMOYLATION_score = "#3498DB", net_sumo_score = "#E74C3C"
  )) +
  labs(
    title = "Significant drug associations (q < 0.05) across SUMO score definitions",
    subtitle = "Positive r = resistance-associated, negative r = sensitivity-associated",
    x = "Spearman r", y = NULL, fill = "Score"
  ) +
  theme_minimal(base_size = 11) + theme(legend.position = "bottom")

print(p_score_comparison)
ggsave("figures/score_definitions_comparison.png", p_score_comparison, width = 9, height = 7, dpi = 300)



# ---- 2.3 Gene-level correlations ----
# The composite score averages all 19 SUMO pathway genes together, but genes
# with opposing biological roles (conjugation vs deconjugation) can pull it
