### ============================================================
### 2. PATHWAY SCORES AND DRUG CORRELATIONS
### ============================================================

# ---- 2.1 Per-gene z-scores (within gene, across patients), used to build
#          all composite scores on a common scale ----

# calculate z-scores for all SUMO pathway genes
sumo_zscores <- sumo_protein_long %>%
  group_by(Gene) %>%
  mutate(z_score = as.numeric(scale(log_ratio))) %>%
  ungroup()

score_from_geneset <- function(zscores, gene_set, score_name) {
  zscores %>%
    filter(Gene %in% gene_set) %>%
    group_by(dbgap_subject_id) %>%
    summarise(!!score_name := mean(z_score, na.rm = TRUE), .groups = "drop")
}

# Composite score (all 19 genes) mixes SUMOylation and deSUMOylation machinery
# members, which act in opposite biological directions; it is retained here
# as a baseline for comparison, not as the primary metric (see gene-level
# results in 2.3, which motivated the split and the E1-complex score below).
composite_score <- score_from_geneset(sumo_zscores, SUMO_PATHWAY_GENES, "composite_score")
SUMOYLATION_score <- score_from_geneset(sumo_zscores, SUMOYLATION_GENES, "SUMOYLATION_score")
DESUMOYLATION_score <- score_from_geneset(sumo_zscores, DESUMOYLATION_GENES, "DESUMOYLATION_score")

pathway_scores <- composite_score %>%
  inner_join(SUMOYLATION_score, by = "dbgap_subject_id") %>%
  inner_join(DESUMOYLATION_score, by = "dbgap_subject_id") %>%
  mutate(net_sumo_score = SUMOYLATION_score - DESUMOYLATION_score)

# ---- 2.2 Correlation of each score with drug AUC ----

# create a table combining SUMO scores and drug AUC
scores_vs_auc <- pathway_scores %>%
  inner_join(drug_auc %>% dplyr::select(dbgap_subject_id, inhibitor, auc), by = "dbgap_subject_id")

# conduct a correlation analysis to see if there is any connection between SUMO pathway activity and drug sensitivity
correlate_score_with_drugs <- function(data, score_col) {
  data %>%
    group_by(inhibitor) %>%
    filter(n() >= MIN_PATIENTS_PER_DRUG) %>%
    summarise(
      n_patients = n(),
      spearman_r = suppressWarnings(cor(.data[[score_col]], auc, method = "spearman", use = "complete.obs")),
      p_value = suppressWarnings(cor.test(.data[[score_col]], auc, method = "spearman")$p.value),
      .groups = "drop"
    ) %>%
    mutate(q_value = p.adjust(p_value, method = "BH")) %>%
    arrange(p_value)
}

score_correlations <- map(
  set_names(c("composite_score", "SUMOYLATION_score", "DESUMOYLATION_score", "net_sumo_score")),
  ~ correlate_score_with_drugs(scores_vs_auc, .x)
)

score_correlations_df <- map2_dfr(
  score_correlations,
  names(score_correlations),
  ~ .x %>% filter(q_value < 0.05) %>% mutate(score = .y)
) %>%
  arrange(desc(abs(spearman_r)))

# Visualization: significant drug associations across score definitions

score_correlations_plot_data <- score_correlations_df %>%
  filter(n_patients >= MIN_PATIENTS_FOR_PLOT) %>%
  mutate(
    direction = if_else(spearman_r > 0, "resistance", "sensitivity"),
