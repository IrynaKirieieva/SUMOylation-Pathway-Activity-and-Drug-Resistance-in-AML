### ============================================================
### 3. SUBTYPE STRATIFICATION (NPM1 / FLT3-ITD)
### ============================================================
# Stratify by NPM1/FLT3 status to test whether E1-complex–drug associations
# are consistent across genetic subgroups or subgroup-specific.

# ---- 3.1 Patient-level mutation status
#
# Patient specimens can disagree on NPM1/FLT3-ITD status across different
# timepoints (e.g. diagnosis vs relapse, reflecting clonal evolution). The
# proteomics data we analyze is a single baseline measurement per patient,
# so we can't tell which specimen's status matches that timepoint. Picking
# one arbitrarily risks assigning the wrong status to the protein/drug data.
# That's why disagreeing patients are marked unknown (NA) and excluded from
# stratified analysis instead. ----

collapse_status <- function(x) {
  x_clean <- na.omit(x)
  if (length(x_clean) == 0) return(NA_character_)
  if (n_distinct(x_clean) > 1) return(NA_character_)
  unique(x_clean)
}

mutation_status <- clinical_bottomly %>%
  mutate(
    NPM1_status = case_when(NPM1 == "positive" ~ "mutant", NPM1 == "negative" ~ "wildtype", TRUE ~ NA_character_),
    FLT3_status = case_when(`FLT3-ITD` == "positive" ~ "mutant", `FLT3-ITD` == "negative" ~ "wildtype", TRUE ~ NA_character_)
  ) %>%
  group_by(dbgap_subject_id) %>%
  summarise(
    NPM1_status = collapse_status(NPM1_status),
    FLT3_status = collapse_status(FLT3_status),
    .groups = "drop"
  )

# ---- 3.2 Stratified correlations for the E1 complex score's top hits ----

stratified_correlation <- function(data, value_col, mutation_col, drugs) {
  data %>%
    left_join(mutation_status, by = "dbgap_subject_id") %>%
    filter(inhibitor %in% drugs, !is.na(.data[[mutation_col]])) %>%
    group_by(inhibitor, .data[[mutation_col]]) %>%
    filter(n() >= MIN_PATIENTS_PER_SUBGROUP) %>%
    summarise(
      n_patients = n(),
      spearman_r = suppressWarnings(cor(.data[[value_col]], auc, method = "spearman", use = "complete.obs")),
      p_value = suppressWarnings(cor.test(.data[[value_col]], auc, method = "spearman")$p.value),
      .groups = "drop"
    )
}

e1_by_npm1 <- stratified_correlation(e1_vs_auc, "e1_score", "NPM1_status", e1_top_drugs)
e1_by_flt3 <- stratified_correlation(e1_vs_auc, "e1_score", "FLT3_status", e1_top_drugs)

# ---- 3.3 Formal test of whether subgroup correlations genuinely differ
#
# Comparing subgroup p-values against a common threshold ("significant in A,
# not in B") is not a valid test of a real subgroup difference — smaller
# subgroups are simply underpowered. This directly compares the correlation
# coefficients via Fisher's z-transformation. ----

compare_correlations <- function(r1, n1, r2, n2) {
  z1 <- atanh(r1); z2 <- atanh(r2)
  se_diff <- sqrt(1 / (n1 - 3) + 1 / (n2 - 3))
  z_stat <- (z1 - z2) / se_diff
  2 * (1 - pnorm(abs(z_stat)))
}

build_interaction_table <- function(strat_result, mutation_col) {
  strat_result %>%
    dplyr::select(inhibitor, !!mutation_col, n_patients, spearman_r) %>%
    pivot_wider(names_from = !!mutation_col, values_from = c(n_patients, spearman_r)) %>%
    filter(!is.na(spearman_r_mutant), !is.na(spearman_r_wildtype)) %>%
    mutate(
      interaction_p_value = compare_correlations(
        spearman_r_mutant, n_patients_mutant, spearman_r_wildtype, n_patients_wildtype
      )
    ) %>%
    arrange(interaction_p_value)
}

# interaction_p_value < 0.05: subgroup difference is statistically supported.
# interaction_p_value >= 0.05: apparent subgroup difference may just reflect
# unequal power — treat as one whole-cohort finding, not two subtype-specific ones.
e1_flt3_interaction <- build_interaction_table(e1_by_flt3, "FLT3_status")
e1_npm1_interaction <- build_interaction_table(e1_by_npm1, "NPM1_status")

